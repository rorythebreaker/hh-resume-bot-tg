TG_BOT_TOKEN=
TG_CHAT_ID=
TZ=Europe/Moscow
TG_INTERACTIVE_BUTTONS=0
BACKUP_PASSWORD=

# auto: try HTMLBubbles, fall back to inline menus if unsupported
TG_HTML_BUBBLES=auto
# Only for an explicitly configured experimental Telegram test endpoint
TG_API_TEST_ENV=0

# HTTPS origin of the Mini App, e.g. https://hh.example.com (blank keeps chat UI)
TG_MINI_APP_URL=

# Segmented HH search. Profile period overrides the default lookback.
APPLY_SEGMENTED=0
APPLY_DISCOVERY_DAYS=7
APPLY_DISCOVERY_REQUESTS=250
